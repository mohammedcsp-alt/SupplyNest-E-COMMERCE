{
  "name": "b2b-store",
  "version": "1.0.0",
  "private": true,
  "description": "B2B general-purpose product e-commerce platform V1 (local development)",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "dotenv -e .env -- tsx prisma/seed/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- tsx prisma/seed/index.ts && playwright test",
    "jobs:sweep": "dotenv -e .env -- tsx --conditions=react-server scripts/jobs-sweep.ts",
    "backup:job": "dotenv -e .env -- tsx --conditions=react-server scripts/backup-job.ts",
    "restore:test": "dotenv -e .env -- tsx --conditions=react-server scripts/restore-test.ts",
    "test:e2e:api": "npm run test:e2e -- --project=api",
    "demo:content": "dotenv -e .env -- tsx --conditions=react-server scripts/demo/seed-demo-content.ts",
    "otp:latest": "dotenv -e .env -- tsx --conditions=react-server scripts/dev-otp.ts",
    "owner:create": "dotenv -e .env -- tsx --conditions=react-server scripts/create-owner.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
