# Copy to .env and fill with LOCAL development values. Never commit .env.
DATABASE_URL="postgresql://b2b_app:CHANGE_ME@127.0.0.1:5440/b2b_store_dev?schema=public"
TEST_DATABASE_URL="postgresql://b2b_app:CHANGE_ME@127.0.0.1:5440/b2b_store_test?schema=public"
APP_SECRET="CHANGE_ME_64_HEX_CHARS"
PORT=3200
NODE_ENV=development
FEATURE_FLAG_WMS_INTEGRATION=false
# mock = development-only OTP simulator (refused when NODE_ENV=production)
OTP_PROVIDER=mock
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./storage/backups
