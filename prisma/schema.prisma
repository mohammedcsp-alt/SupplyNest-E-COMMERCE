// B2B-STORE V1 — logical data model (see ARCHITECTURE.md and IMPLEMENTATION_DECISIONS.md).
// All money columns are DECIMAL(18,0): IQD is stored as whole dinars (OPEN-08 default).
// Database-level CHECK constraints, partial unique indexes and the append-only audit trigger
// live in migrations/*/migration.sql (Prisma cannot express them in schema.prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum AccountStatus {
  REGISTERED
  APPROVAL_PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum UserType {
  CUSTOMER
  STAFF
}

enum OtpPurpose {
  REGISTRATION
  ACCESS_RECOVERY
}

enum OrderStatus {
  SUBMITTED
  ON_HOLD_LOCAL
  CANCELLATION_REQUESTED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  REVIEW_REQUIRED
  EXTENDED
  RELEASED
  CONSUMED
}

enum InventoryMovementType {
  IMPORT_SET
  MANUAL_ADJUST
  RESERVATION_HOLD
  RESERVATION_RELEASE
  RESERVATION_CONSUME
  HANDOVER_DEDUCT
  RETURN_RESTOCK
}

enum AlertType {
  LOW_STOCK
  STALE_DATA
  RESERVATION_REVIEW
  STOCK_CONFLICT
  SHORTAGE
}

enum AlertState {
  OPEN
  RESOLVED
}

enum ImportType {
  PRODUCTS
  PRICES
}

enum ImportStatus {
  PREVIEW_VALID
  PREVIEW_INVALID
  COMMITTED
  REJECTED
}

enum Freshness {
  FRESH
  STALE
  UNKNOWN
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

enum FulfillmentStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKING
  PICKED
  CHECKING
  DISCREPANCY_HOLD
  CHECKED
  PACKING
  PACKED
  HANDED_OVER
  CANCELLED
}

enum SettlementMode {
  NET_DEDUCTION
  GROSS_REMITTANCE
}

enum DeliveryStatus {
  HANDED_OVER
  DELIVERED_REPORTED
  PARTIALLY_REJECTED
  REJECTED
  RETURNED
}

enum AdjustmentType {
  REJECTION_PARTIAL
  REJECTION_FULL
  RETURN
  CUSTOMER_REFUND
  DISCOUNT
  COURIER_CORRECTION
}

enum RemittanceMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum InvoiceStatus {
  ISSUED
  SUPERSEDED
}

enum ProposalStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxStatus {
  DISABLED
  PENDING
  SENT
}

// ---------------------------------------------------------------- identity & access

model User {
  id              String        @id @default(uuid()) @db.Uuid
  phone           String        @unique @db.VarChar(20)
  passwordHash    String        @db.VarChar(255)
  userType        UserType      @default(CUSTOMER)
  status          AccountStatus @default(REGISTERED)
  phoneVerifiedAt DateTime?     @db.Timestamptz(3)
  fullNameAr      String?       @db.VarChar(120)
  fullNameEn      String?       @db.VarChar(120)
  lastLoginAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  customerProfile  CustomerProfile?
  sessions         Session[]
  userRoles        UserRole[]
  otpChallenges    OtpChallenge[]
  statusHistory    AccountStatusHistory[]    @relation("statusSubject")
  priceAssignments CustomerPriceAssignment[] @relation("assignmentCustomer")
  notifications    Notification[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]                   @relation("orderCustomer")
  favorites        Favorite[]
  recentViews      RecentView[]
  idempotency      IdempotencyRecord[]

  @@index([userType, status])
  @@map("users")
}

model CustomerProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  displayName            String   @db.VarChar(120)
  legalName              String?  @db.VarChar(200)
  businessIdentityLocked Boolean  @default(false)
  currentPriceLevelId    String?  @db.Uuid
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  priceLevel PriceLevel? @relation(fields: [currentPriceLevelId], references: [id])

  @@map("customer_profiles")
}

model AccountStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  subjectId  String         @db.Uuid
  fromStatus AccountStatus?
  toStatus   AccountStatus
  reason     String?        @db.VarChar(500)
  actorId    String?        @db.Uuid
  occurredAt DateTime       @default(now()) @db.Timestamptz(3)

  subject User @relation("statusSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([subjectId, occurredAt])
  @@map("account_status_history")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  nameAr    String?  @db.VarChar(120)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(128)
  expiresAt  DateTime   @db.Timestamptz(3)
  attempts   Int        @default(0)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("otp_challenges")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  userAgent String?   @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PriceLevel {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  customers    CustomerProfile[]
  assignments  CustomerPriceAssignment[]
  tierPrices   TierPrice[]
  priceHistory PriceChangeHistory[]

  @@map("price_levels")
}

model CustomerPriceAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  priceLevelId String   @db.Uuid
  effectiveAt  DateTime @default(now()) @db.Timestamptz(3)
  assignedById String?  @db.Uuid
  reason       String?  @db.VarChar(500)

  customer   User       @relation("assignmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Restrict)

  @@index([customerId, effectiveAt])
  @@map("customer_price_assignments")
}

// ---------------------------------------------------------------- locations & shipping rules

model Governorate {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(40)
  nameAr    String  @db.VarChar(120)
  nameEn    String  @db.VarChar(120)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  areas             DeliveryArea[]
  addresses         Address[]
  rules             ShippingRateRule[]
  courierAgreements CourierAgreement[]

  @@map("governorates")
}

model DeliveryArea {
  id            String  @id @default(uuid()) @db.Uuid
  governorateId String  @db.Uuid
  nameAr        String  @db.VarChar(120)
  nameEn        String  @db.VarChar(120)
  active        Boolean @default(true)

  governorate Governorate        @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  addresses   Address[]
  rules       ShippingRateRule[]

  @@index([governorateId])
  @@map("delivery_areas")
}

model Address {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String    @db.Uuid
  governorateId  String    @db.Uuid
  areaId         String?   @db.Uuid
  label          String?   @db.VarChar(80)
  details        String    @db.VarChar(500)
  recipientName  String    @db.VarChar(120)
  recipientPhone String    @db.VarChar(20)
  isDefault      Boolean   @default(false)
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  customer    User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  governorate Governorate   @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  area        DeliveryArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("addresses")
}

model ShippingRateRule {
  id            String    @id @default(uuid()) @db.Uuid
  governorateId String    @db.Uuid
  areaId        String?   @db.Uuid
  amount        Decimal   @db.Decimal(18, 0)
  currency      String    @default("IQD") @db.VarChar(3)
  effectiveFrom DateTime  @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  active        Boolean   @default(true)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  governorate Governorate   @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  area        DeliveryArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([governorateId, areaId, effectiveFrom])
  @@map("shipping_rate_rules")
}

// ---------------------------------------------------------------- catalog

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  parentId  String?   @db.Uuid
  slug      String    @unique @db.VarChar(120)
  nameAr    String    @db.VarChar(160)
  nameEn    String    @db.VarChar(160)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  /**
   * V3.3: optional category image (storage key under UPLOAD_DIR).
   */
  imageKey  String?   @db.VarChar(255)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  parent     Category?             @relation("categoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]            @relation("categoryTree")
  skus       Sku[]
  attributes AttributeDefinition[]

  @@index([parentId])
  @@map("categories")
}

model AttributeDefinition {
  id         String        @id @default(uuid()) @db.Uuid
  categoryId String        @db.Uuid
  key        String        @db.VarChar(60)
  labelAr    String        @db.VarChar(120)
  labelEn    String        @db.VarChar(120)
  dataType   AttributeType @default(TEXT)
  unit       String?       @db.VarChar(20)
  options    Json?
  filterable Boolean       @default(false)
  required   Boolean       @default(false)
  sortOrder  Int           @default(0)

  category Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values   SkuAttributeValue[]

  @@unique([categoryId, key])
  @@map("attribute_definitions")
}

model SkuAttributeValue {
  skuId                 String @db.Uuid
  attributeDefinitionId String @db.Uuid
  value                 String @db.VarChar(500)

  sku        Sku                 @relation(fields: [skuId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@id([skuId, attributeDefinitionId])
  @@map("sku_attribute_values")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(160)
  slug      String   @unique @db.VarChar(160)
  active    Boolean  @default(true)
  /**
   * V3.3: optional brand logo or image (storage key under UPLOAD_DIR).
   */
  imageKey  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  models ProductModel[]
  skus   Sku[]

  @@map("brands")
}

model ProductModel {
  id             String   @id @default(uuid()) @db.Uuid
  brandId        String?  @db.Uuid
  name           String   @db.VarChar(200)
  normalizedName String   @db.VarChar(200)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  skus  Sku[]

  @@unique([brandId, normalizedName])
  @@map("product_models")
}

model Quality {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(40)
  nameAr    String  @db.VarChar(120)
  nameEn    String  @db.VarChar(120)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  skus Sku[]

  @@map("qualities")
}

model Sku {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique @db.VarChar(64)
  categoryId    String    @db.Uuid
  brandId       String?   @db.Uuid
  modelId       String?   @db.Uuid
  qualityId     String?   @db.Uuid
  nameAr        String    @db.VarChar(255)
  nameEn        String    @db.VarChar(255)
  descriptionAr String?   @db.Text
  descriptionEn String?   @db.Text
  unit          String    @default("PCS") @db.VarChar(20)
  active        Boolean   @default(true)
  published     Boolean   @default(false)
  deletedAt     DateTime? @db.Timestamptz(3)
  /**
   * V3.3: merchandising flags. Do not affect price, stock or eligibility.
   */
  featured      Boolean   @default(false)
  featuredOrder Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           Brand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model           ProductModel?          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  quality         Quality?               @relation(fields: [qualityId], references: [id], onDelete: Restrict)
  images          SkuImage[]
  tierPrices      TierPrice[]
  priceHistory    PriceChangeHistory[]
  inventory       InventoryBalance?
  movements       InventoryMovement[]
  reservations    InventoryReservation[]
  alerts          InventoryAlert[]
  attributeValues SkuAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  favorites       Favorite[]
  recentViews     RecentView[]

  @@index([categoryId])
  @@index([modelId])
  @@index([published, active])
  @@index([featured, featuredOrder])
  @@map("product_skus")
}

model SkuImage {
  id        String   @id @default(uuid()) @db.Uuid
  skuId     String   @db.Uuid
  fileKey   String   @unique @db.VarChar(255)
  mimeType  String   @db.VarChar(40)
  sortOrder Int      @default(0)
  altText   String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, sortOrder])
  @@map("sku_images")
}

model TierPrice {
  id           String   @id @default(uuid()) @db.Uuid
  skuId        String   @db.Uuid
  priceLevelId String   @db.Uuid
  amount       Decimal  @db.Decimal(18, 0)
  currency     String   @default("IQD") @db.VarChar(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  updatedById  String?  @db.Uuid

  sku        Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Restrict)

  @@unique([skuId, priceLevelId])
  @@map("tier_prices")
}

model PriceChangeHistory {
  id           String   @id @default(uuid()) @db.Uuid
  skuId        String   @db.Uuid
  priceLevelId String   @db.Uuid
  oldAmount    Decimal? @db.Decimal(18, 0)
  newAmount    Decimal  @db.Decimal(18, 0)
  actorId      String?  @db.Uuid
  source       String   @db.VarChar(40)
  importId     String?  @db.Uuid
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)

  sku        Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Restrict)

  @@index([skuId, occurredAt])
  @@map("price_change_history")
}

// ---------------------------------------------------------------- inventory

model InventoryBalance {
  skuId           String    @id @db.Uuid
  physicalOnHand  Int       @default(0)
  reservedQty     Int       @default(0)
  version         Int       @default(0)
  sourceTimestamp DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@map("inventory_balances")
}

model InventoryReservation {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @db.Uuid
  skuId        String            @db.Uuid
  qty          Int
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime          @db.Timestamptz(3)
  reviewedById String?           @db.Uuid
  reviewReason String?           @db.VarChar(500)
  releasedAt   DateTime?         @db.Timestamptz(3)
  consumedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([skuId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id           String                @id @default(uuid()) @db.Uuid
  skuId        String                @db.Uuid
  qtyDelta     Int
  balanceAfter Int
  movementType InventoryMovementType
  sourceRef    String?               @db.VarChar(120)
  actorId      String?               @db.Uuid
  note         String?               @db.VarChar(500)
  occurredAt   DateTime              @default(now()) @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, occurredAt])
  @@map("inventory_movements")
}

model InventoryAlert {
  id         String     @id @default(uuid()) @db.Uuid
  skuId      String     @db.Uuid
  alertType  AlertType
  state      AlertState @default(OPEN)
  detail     Json?
  detectedAt DateTime   @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?  @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  // partial unique index (one OPEN alert per SKU and type) is added in migration SQL
  @@index([state, alertType])
  @@map("inventory_alerts")
}

// ---------------------------------------------------------------- imports

model ImportBatch {
  id                String       @id @default(uuid()) @db.Uuid
  type              ImportType
  filename          String       @db.VarChar(255)
  checksum          String       @db.VarChar(128)
  sourceGeneratedAt DateTime?    @db.Timestamptz(3)
  freshness         Freshness    @default(UNKNOWN)
  status            ImportStatus
  uploadedById      String?      @db.Uuid
  payload           Json
  summary           Json
  overrideById      String?      @db.Uuid
  overrideReason    String?      @db.VarChar(500)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  committedAt       DateTime?    @db.Timestamptz(3)

  errors ImportError[]

  @@index([type, status])
  @@map("imports")
}

model ImportError {
  id        String  @id @default(uuid()) @db.Uuid
  importId  String  @db.Uuid
  rowNumber Int
  field     String? @db.VarChar(60)
  code      String  @db.VarChar(60)
  message   String  @db.VarChar(500)

  batch ImportBatch @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_errors")
}

// ---------------------------------------------------------------- commerce

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  cartId  String   @db.Uuid
  skuId   String   @db.Uuid
  qty     Int
  addedAt DateTime @default(now()) @db.Timestamptz(3)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@id([cartId, skuId])
  @@map("cart_items")
}

model Favorite {
  customerId String   @db.Uuid
  skuId      String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sku      Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([customerId, skuId])
  @@map("favorites")
}

model RecentView {
  customerId String   @db.Uuid
  skuId      String   @db.Uuid
  viewedAt   DateTime @default(now()) @db.Timestamptz(3)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sku      Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([customerId, skuId])
  @@map("recent_views")
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  orderNumber         String      @unique @db.VarChar(32)
  customerId          String      @db.Uuid
  status              OrderStatus @default(SUBMITTED)
  subtotal            Decimal     @db.Decimal(18, 0)
  shippingFee         Decimal     @db.Decimal(18, 0)
  totalCod            Decimal     @db.Decimal(18, 0)
  currency            String      @default("IQD") @db.VarChar(3)
  governorateId       String      @db.Uuid
  areaId              String?     @db.Uuid
  addressSnapshot     Json
  priceLevelCode      String      @db.VarChar(40)
  customerNote        String?     @db.VarChar(500)
  version             Int         @default(1)
  idempotencyKey      String      @db.VarChar(128)
  submittedAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)
  fulfillmentLockedAt DateTime?   @db.Timestamptz(3)

  customer          User                   @relation("orderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  events            OrderEvent[]
  reservations      InventoryReservation[]
  cancellation      CancellationRequest?
  mergeLinks        MergeProposalOrder[]
  fulfillmentJob    FulfillmentJob?
  shipment          CourierShipment?
  invoices          SalesInvoice[]
  idempotencyRecord IdempotencyRecord?

  @@index([customerId, submittedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  skuId           String   @db.Uuid
  skuSnapshot     String   @db.VarChar(64)
  titleSnapshot   String   @db.VarChar(255)
  qualitySnapshot String?  @db.VarChar(120)
  qty             Int
  unitPrice       Decimal  @db.Decimal(18, 0)
  lineTotal       Decimal  @db.Decimal(18, 0)
  priceLevelCode  String   @db.VarChar(40)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  pickLines PickLine[]

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  eventType  String       @db.VarChar(60)
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  actorId    String?      @db.Uuid
  reason     String?      @db.VarChar(500)
  metadata   Json?
  occurredAt DateTime     @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
  @@map("order_events")
}

model CancellationRequest {
  id            String             @id @default(uuid()) @db.Uuid
  orderId       String             @unique @db.Uuid
  requestedById String             @db.Uuid
  reason        String             @db.VarChar(500)
  status        CancellationStatus @default(PENDING)
  decidedById   String?            @db.Uuid
  decidedAt     DateTime?          @db.Timestamptz(3)
  decisionNote  String?            @db.VarChar(500)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("cancellation_requests")
}

model MergeProposal {
  id           String         @id @default(uuid()) @db.Uuid
  customerId   String         @db.Uuid
  status       ProposalStatus @default(PROPOSED)
  rationale    String         @db.VarChar(500)
  proposedById String?        @db.Uuid
  respondedAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  orders MergeProposalOrder[]

  @@map("merge_proposals")
}

model MergeProposalOrder {
  proposalId String @db.Uuid
  orderId    String @db.Uuid

  proposal MergeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([proposalId, orderId])
  @@map("merge_proposal_orders")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  key         String   @db.VarChar(128)
  requestHash String   @db.VarChar(128)
  orderId     String?  @unique @db.Uuid
  status      String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([customerId, key])
  @@map("idempotency_records")
}

model BulkOrderUpload {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @db.Uuid
  filename          String   @db.VarChar(255)
  status            String   @db.VarChar(30)
  validationSummary Json
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId])
  @@map("bulk_order_uploads")
}

// ---------------------------------------------------------------- notifications, CMS, audit, ops

model Notification {
