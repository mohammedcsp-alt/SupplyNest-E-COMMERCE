  @@map("packages")
}

// ---------------------------------------------------------------- accounting module (temporary, replaceable)

model Courier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  contact   String?  @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  agreements  CourierAgreement[]
  shipments   CourierShipment[]
  remittances CourierRemittance[]
  feePayments CourierFeePayment[]

  @@map("couriers")
}

model CourierAgreement {
  id             String         @id @default(uuid()) @db.Uuid
  courierId      String         @db.Uuid
  settlementMode SettlementMode
  effectiveFrom  DateTime       @db.Timestamptz(3)
  effectiveTo    DateTime?      @db.Timestamptz(3)
  governorateId  String?        @db.Uuid
  serviceFee     Decimal        @db.Decimal(18, 0)
  returnFee      Decimal        @default(0) @db.Decimal(18, 0)
  feeRuleJson    Json?
  active         Boolean        @default(true)
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  courier     Courier           @relation(fields: [courierId], references: [id], onDelete: Restrict)
  governorate Governorate?      @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  shipments   CourierShipment[]

  @@index([courierId, effectiveFrom])
  @@map("courier_agreements")
}

model CourierShipment {
  id                     String         @id @default(uuid()) @db.Uuid
  orderId                String         @unique @db.Uuid
  courierId              String         @db.Uuid
  agreementId            String         @db.Uuid
  settlementModeSnapshot SettlementMode
  customerFeeSnapshot    Decimal        @db.Decimal(18, 0)
  courierFeeSnapshot     Decimal        @db.Decimal(18, 0)
  codExpectedBase        Decimal        @db.Decimal(18, 0)
  codCollected           Decimal?       @db.Decimal(18, 0)
  codCollectedAt         DateTime?      @db.Timestamptz(3)
  courierFeeDeducted     Decimal?       @db.Decimal(18, 0)
  deliveryStatus         DeliveryStatus @default(HANDED_OVER)
  handedOverAt           DateTime       @default(now()) @db.Timestamptz(3)
  handedOverById         String?        @db.Uuid
  trackingNote           String?        @db.VarChar(255)

  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier         Courier                 @relation(fields: [courierId], references: [id], onDelete: Restrict)
  agreement       CourierAgreement        @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  adjustments     FinancialAdjustment[]
  allocations     RemittanceAllocation[]
  financialEvents CourierFinancialEvent[]

  @@index([courierId])
  @@map("courier_shipments")
}

model CourierFinancialEvent {
  id             String   @id @default(uuid()) @db.Uuid
  shipmentId     String   @db.Uuid
  eventType      String   @db.VarChar(60)
  amount         Decimal  @db.Decimal(18, 0)
  reference      String?  @db.VarChar(120)
  idempotencyKey String   @unique @db.VarChar(128)
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  actorId        String?  @db.Uuid

  shipment CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@map("courier_financial_events")
}

model CourierRemittance {
  id             String           @id @default(uuid()) @db.Uuid
  courierId      String           @db.Uuid
  reference      String           @db.VarChar(120)
  grossAmount    Decimal          @db.Decimal(18, 0)
  receivedAt     DateTime         @db.Timestamptz(3)
  method         RemittanceMethod @default(CASH)
  note           String?          @db.VarChar(500)
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  idempotencyKey String           @unique @db.VarChar(128)

  courier     Courier                @relation(fields: [courierId], references: [id], onDelete: Restrict)
  allocations RemittanceAllocation[]

  @@unique([courierId, reference])
  @@map("courier_remittances")
}

model RemittanceAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  remittanceId    String   @db.Uuid
  shipmentId      String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(18, 0)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  remittance CourierRemittance @relation(fields: [remittanceId], references: [id], onDelete: Restrict)
  shipment   CourierShipment   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([remittanceId, shipmentId])
  @@map("remittance_allocations")
}

model CourierFeePayment {
  id             String   @id @default(uuid()) @db.Uuid
  courierId      String   @db.Uuid
  agreementId    String?  @db.Uuid
  amount         Decimal  @db.Decimal(18, 0)
  paidAt         DateTime @db.Timestamptz(3)
  reference      String   @db.VarChar(120)
  recordedById   String?  @db.Uuid
  idempotencyKey String   @unique @db.VarChar(128)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Restrict)

  @@unique([courierId, reference])
  @@map("courier_fee_payments")
}

model FinancialAdjustment {
  id             String         @id @default(uuid()) @db.Uuid
  shipmentId     String         @db.Uuid
  type           AdjustmentType
  signedAmount   Decimal        @db.Decimal(18, 0)
  reason         String         @db.VarChar(500)
  requestedById  String?        @db.Uuid
  approvedById   String         @db.Uuid
  reversesId     String?        @unique @db.Uuid
  idempotencyKey String         @unique @db.VarChar(128)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  shipment CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("financial_adjustments")
}

model SalesInvoice {
  id                  String        @id @default(uuid()) @db.Uuid
  invoiceNumber       String        @unique @db.VarChar(40)
  orderId             String        @db.Uuid
  revision            Int           @default(1)
  status              InvoiceStatus @default(ISSUED)
  currency            String        @default("IQD") @db.VarChar(3)
  goodsTotal          Decimal       @db.Decimal(18, 0)
  customerDeliveryFee Decimal       @db.Decimal(18, 0)
  grandTotal          Decimal       @db.Decimal(18, 0)
  lines               Json
  reason              String?       @db.VarChar(500)
  issuedAt            DateTime      @default(now()) @db.Timestamptz(3)
  issuedById          String?       @db.Uuid
  printCount          Int           @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, revision])
  @@map("sales_invoices")
}
