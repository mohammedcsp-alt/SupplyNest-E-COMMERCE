model FulfillmentJob {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @unique @db.Uuid
  status            FulfillmentStatus @default(PENDING_ASSIGNMENT)
  prepDocumentNo    String            @unique @db.VarChar(40)
  prepPrintCount    Int               @default(0)
  assignedPickerId  String?           @db.Uuid
  assignedCheckerId String?           @db.Uuid
  assignedAt        DateTime?         @db.Timestamptz(3)
  startedAt         DateTime?         @db.Timestamptz(3)
  completedAt       DateTime?         @db.Timestamptz(3)
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines    PickLine[]
  packages Package[]
  events   FulfillmentEvent[]

  @@index([status])
  @@map("fulfillment_jobs")
}

model FulfillmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @db.Uuid
  eventType  String   @db.VarChar(60)
  actorId    String?  @db.Uuid
  metadata   Json?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  job FulfillmentJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, occurredAt])
  @@map("fulfillment_events")
}

model PickLine {
